From 7dce029458ff7fe51cf2027e0c1c04862eb3bc48 Mon Sep 17 00:00:00 2001
From: Toby Flynn <tflynn@redwiretechnology.com>
Date: Tue, 30 Jun 2026 12:20:48 -0400
Subject: [PATCH] supporting libiio_v1

---
 cmake/Modules/Findlibiio.cmake   |   2 +-
 gr-iio/CMakeLists.txt            |  12 ++
 gr-iio/lib/CMakeLists.txt        |   4 +
 gr-iio/lib/attr_sink_impl.cc     |  33 +++++
 gr-iio/lib/attr_sink_impl.h      |   4 +
 gr-iio/lib/attr_source_impl.cc   | 117 +++++++++++++++++
 gr-iio/lib/dds_control_impl.cc   |  35 ++++++
 gr-iio/lib/dds_control_impl.h    |   4 +
 gr-iio/lib/device_sink_impl.cc   |  74 ++++++++++-
 gr-iio/lib/device_sink_impl.h    |  11 ++
 gr-iio/lib/device_source_impl.cc | 208 ++++++++++++++++++++++++++++++-
 gr-iio/lib/device_source_impl.h  |  18 +++
 gr-iio/lib/pluto_utils.cc        |  38 +++++-
 13 files changed, 551 insertions(+), 9 deletions(-)

diff --git a/cmake/Modules/Findlibiio.cmake b/cmake/Modules/Findlibiio.cmake
index c37b8ab2c..12a700e60 100644
--- a/cmake/Modules/Findlibiio.cmake
+++ b/cmake/Modules/Findlibiio.cmake
@@ -51,7 +51,7 @@ pkg_check_modules(PC_libiio QUIET libiio)
 
 find_path(
     libiio_INCLUDE_DIR
-    NAMES iio.h
+    NAMES iio.h iio/iio.h
     HINTS ${PC_libiio_INCLUDE_DIRS}
     PATHS /usr/include /usr/local/include /opt/local/include)
 
diff --git a/gr-iio/CMakeLists.txt b/gr-iio/CMakeLists.txt
index 296fd8eaf..41706c3d5 100644
--- a/gr-iio/CMakeLists.txt
+++ b/gr-iio/CMakeLists.txt
@@ -51,6 +51,18 @@ set(GR_PKG_IIO_EXAMPLES_DIR ${GR_PKG_DATA_DIR}/examples/iio)
 ########################################################################
 if(ENABLE_GR_IIO)
 
+    ########################################################################
+    # Setup libiio version
+    ########################################################################
+    if(libiio_FOUND)
+        if(${libiio_VERSION} LESS 1.0)
+            message(STATUS "Using libiio v0 (old version) " ${libiio_VERSION})
+        else()
+            set(LIBIIO_V1 TRUE)
+            message(STATUS "Using libiio v1 (new version) " ${libiio_VERSION})
+        endif()
+    endif(libiio_FOUND)
+
     ########################################################################
     # Add subdirectories
     ########################################################################
diff --git a/gr-iio/lib/CMakeLists.txt b/gr-iio/lib/CMakeLists.txt
index 50c9431e0..f55facee2 100644
--- a/gr-iio/lib/CMakeLists.txt
+++ b/gr-iio/lib/CMakeLists.txt
@@ -51,3 +51,7 @@ endif(MSVC)
 if(BUILD_SHARED_LIBS)
     gr_library_foo(gnuradio-iio)
 endif()
+
+if(LIBIIO_V1)
+    target_compile_definitions(gnuradio-iio PUBLIC LIBIIO_V1)
+endif()
diff --git a/gr-iio/lib/attr_sink_impl.cc b/gr-iio/lib/attr_sink_impl.cc
index 3d9b592c7..3fec5603b 100644
--- a/gr-iio/lib/attr_sink_impl.cc
+++ b/gr-iio/lib/attr_sink_impl.cc
@@ -91,6 +91,38 @@ void attr_sink_impl::write_attribute(pmt::pmt_t pdu)
         value =
             pmt::symbol_to_string(pmt::dict_ref(pdu, pmt::nth(k, keys), pmt::PMT_NIL));
 
+#ifdef LIBIIO_V1
+        const iio_attr* iio_attribute = nullptr;
+        switch (type) {
+        case attr_type_t::CHANNEL:
+            iio_attribute = iio_channel_find_attr(chan, attribute.c_str());
+            if (!iio_attribute)
+                ret = -EINVAL;
+            else
+                ret = iio_attr_write_string(iio_attribute, value.c_str());
+            break;
+        case attr_type_t::DEVICE:
+            iio_attribute = iio_device_find_attr(dev, attribute.c_str());
+            if (!iio_attribute)
+                ret = -EINVAL;
+            else
+                ret = iio_attr_write_string(iio_attribute, value.c_str());
+            break;
+        case attr_type_t::DEVICE_BUFFER:
+            iio_attribute = iio_device_find_attr(dev, attribute.c_str());
+            if (!iio_attribute)
+                ret = -EINVAL;
+            else
+                ret = iio_attr_write_string(iio_attribute, value.c_str());
+            break;
+        case attr_type_t::DEVICE_DEBUG:
+            iio_attribute = iio_device_find_debug_attr(dev, attribute.c_str());
+            if (!iio_attribute)
+                ret = -EINVAL;
+            else
+                ret = iio_attr_write_string(iio_attribute, value.c_str());
+            break;
+#else
         switch (type) {
         case attr_type_t::CHANNEL:
             ret = iio_channel_attr_write(chan, attribute.c_str(), value.c_str());
@@ -104,6 +136,7 @@ void attr_sink_impl::write_attribute(pmt::pmt_t pdu)
         case attr_type_t::DEVICE_DEBUG:
             ret = iio_device_debug_attr_write(dev, attribute.c_str(), value.c_str());
             break;
+#endif
         default: // case 4:
             uint32_t address, value32;
 
